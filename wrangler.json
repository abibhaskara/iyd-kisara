{
	"name": "iyd-kisara",
	"main": "worker.js",
	"compatibility_date": "2024-12-01",
	"routes": [
		{
			"pattern": "iyd.abibhaskara.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"build": {
		"command": "npm run build"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "iyd-kisara-db",
			"database_id": "1047f8ac-f454-426a-965c-c17fbb0e8f20"
		}
	]
}